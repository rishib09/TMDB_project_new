# ==============================================================================
# TMDB RAG & Evaluation Harness ("Maya") - Environment Variables Template
# Managed via dotenvx (https://dotenvx.com)
# ==============================================================================

# --- OpenRouter API (Required for Maya Intent Router & Synthesis LLMs) ---
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- TMDB API v3 (Required for 1970-2026 data ingestion script) ---
# Obtain from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# --- Hugging Face API Token (Required for Spaces Deployment & Secret Sync) ---
# Obtain from: https://huggingface.co/settings/tokens (Role: Write)
HF_TOKEN=hf_your_huggingface_token_here

# --- Langfuse Observability & Telemetry (Optional for cloud logging) ---
# Obtain from: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
